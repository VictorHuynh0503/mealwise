# Primary: Cursor Cloud Agents (photo recognition)
CURSOR_KEY=crsr_...
VISION_PROVIDER=cursor

# Valid ids from GET https://api.cursor.com/v1/models (not composer-2)
CURSOR_MODEL=claude-haiku-5-5
# Only used when CURSOR_MODEL=auto-smart
CURSOR_OPTIMIZE_FOR=cost

# Optional Anthropic fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
